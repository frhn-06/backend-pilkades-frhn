<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <style>
      * {
        color: #333;
        font-family: Arial, Helvetica, sans-serif;
        margin: 0;
      }
    

      body {
        box-sizing: border-box;
        padding: 0;
      }

      #main {
        width: 100%;
        max-width: 36rem;
        min-height: 10rem;
        background-color: #eee;
        margin: 4rem auto;
        border-radius: .4rem;
        overflow: hidden;
      }

      #header {
        background-color: rgb(254, 168, 168);
        min-height: 4rem;
        display: flex;
        justify-content: center;
        align-items: center;
      }

      #header h1 {
        font-weight: bold;
      }

      #body {
        padding: 1.5rem 1rem;
      }

      #body p {
        margin-bottom: 1rem;
      }

      #otp-content {
        padding: 1rem;
        display: flex;
        flex-direction: column;
        gap: .5rem;
        margin-bottom: 1rem;
      }

      #otp-content p {
        font-weight: bold;
        font-size: 2rem;
        margin-bottom: .5rem;
      }

      #otp {
        font-weight: bold;
        color: rgb(196, 9, 9);
        font-size: 4rem;
      }

      #footer {
        min-height: 2rem;
        background-color: #ccc;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      #footer p {
        font-size: .8rem;
        font-weight: bold;
      }
    </style>
</head>
<body>
    <div id="main">
      <div id="header">
        <h1>
          E-Voting System
        </h1>
      </div>

      <div id="body">
        <p>
          Halo <%= name %>,
        </p>
        <p>
          Berikut adalah kode OTP untuk mengatur ulang password akun Anda:
        </p>
        
        <div id="otp-content">
          <p>
            Kode OTP :
          </p>
          <p id="otp">
            <%= token %>
          </p>
        </div>

        <p>
          Berlaku sampai :
        </p>
        <p>
          <%= expired %>
        </p>
        <p>
          Jangan bagikan kode ini kepada siapa pun.
        </p>
        <p>
          Jika Anda merasa tidak meminta reset password, abaikan email ini.
        </p>
      </div>

      <div id="footer">
        <p>
          &copy; 2026 | E-Voting System
        </p>
      </div>
    </div>
</body>
</html>