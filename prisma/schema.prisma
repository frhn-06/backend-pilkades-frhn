generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             Int      @id @default(autoincrement())
  name           String
  email          String   @unique
  password       String
  role           UserRole
  tpsId          Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  activationCode String?
  isActive       Boolean  @default(true)
  tps            Tps?     @relation(fields: [tpsId], references: [id])
}

model Tps {
  id        Int      @id @default(autoincrement())
  name      String
  alamat    String
  rt        Int
  rw        Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]
}

enum UserRole {
  SUPER_ADMIN
  PETUGAS
}
