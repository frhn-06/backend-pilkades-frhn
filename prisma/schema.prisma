generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             Int      @id @default(autoincrement())
  name           String
  email          String   @unique
  password       String
  role           UserRole
  tpsId          Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  activationCode String?
  isActive       Boolean  @default(true)
  tps            Tps?     @relation(fields: [tpsId], references: [id])
}

model Tps {
  id        Int      @id @default(autoincrement())
  name      String
  alamat    String
  rt        Int
  rw        Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]
}


model Election {
  id              Int             @id @default(autoincrement())
  name            String
  desa            String
  kecamatan       String
  kabupatenKota   String
  provinsi        String
  description     String?
  logo            String?
  startAt         DateTime
  endAt           DateTime
  status          ElectionStatus  @default(DRAFT)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

enum UserRole {
  SUPER_ADMIN
  PETUGAS
}

enum ElectionStatus {
  DRAFT
  UPCOMMING
  ONGOING
  FINISHED
  CANCELLED
}