generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             Int        @id @default(autoincrement())
  name           String
  email          String     @unique
  password       String
  role           UserRole
  tpsId          Int?
  electionId     Int?

  activationCode String?
  isActive       Boolean    @default(true)

  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  tps            Tps?       @relation(fields: [tpsId], references: [id])
  election       Election?  @relation(fields: [electionId], references: [id])

  @@index([electionId, isActive])
  @@index([electionId])
}

model Election {
  id                Int             @id @default(autoincrement())
  name              String
  desa              String
  kecamatan         String
  kabupatenKota     String
  provinsi          String
  description       String?
  logo              String?
  startAt           DateTime
  endAt             DateTime
  status            ElectionStatus  @default(DRAFT)

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  users             User[]
  tps               Tps[]
  candidates        Candidate[]
  candidateMembers  CandidateMember[]
}


model Tps {
  id          Int      @id @default(autoincrement())
  name        String
  alamat      String
  rt          Int
  rw          Int

  electionId  Int

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  election    Election @relation(fields: [electionId], references: [id])

  users       User[]

  @@index([electionId])
}


model Candidate {
  id                Int               @id @default(autoincrement())
  nomor             Int
  img               String
  vision            String
  mission           String
  electionId        Int
  
  election          Election          @relation(fields: [electionId], references: [id])

  members           CandidateMember[]
  
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([electionId])
  @@unique([electionId, nomor])
}

model CandidateMember {
  id                Int               @id @default(autoincrement())
  name              String
  img               String?
  position          String
  order             Int
  electionId        Int
  candidateId       Int
  
  election          Election          @relation(fields: [electionId], references: [id])
  candidate         Candidate         @relation(fields: [candidateId], references: [id])

  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([electionId])
  @@index([candidateId])
  @@unique([position, candidateId])
}

enum UserRole {
  SUPER_ADMIN
  PETUGAS
}

enum ElectionStatus {
  DRAFT
  UPCOMING
  ONGOING
  FINISHED
  CANCELLED
}