generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             Int        @id @default(autoincrement())
  name           String
  email          String     @unique
  password       String
  role           UserRole
  tpsId          Int?
  electionId     Int?

  activationCode String?
  isActive       Boolean    @default(true)

  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  tps            Tps?       @relation(fields: [tpsId], references: [id])
  election       Election?  @relation(fields: [electionId], references: [id])

  @@index([electionId, isActive])
  @@index([electionId])
}

model Election {
  id              Int             @id @default(autoincrement())
  name            String
  desa            String
  kecamatan       String
  kabupatenKota   String
  provinsi        String
  description     String?
  logo            String?
  startAt         DateTime
  endAt           DateTime
  status          ElectionStatus  @default(DRAFT)

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  users           User[]
  tps             Tps[]
  candidates      Candidate[]
}


model Tps {
  id          Int      @id @default(autoincrement())
  name        String
  alamat      String
  rt          Int
  rw          Int

  electionId  Int

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  election    Election @relation(fields: [electionId], references: [id])

  users       User[]

  @@index([electionId])
}


model Candidate {
  id                Int               @id @default(autoincrement())
  nomor_urut        Int
  name              String
  img               String
  vision            String
  mission           String
  electionId        Int
  
  election          Election          @relation(fields: [electionId], references: [id])
  
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([electionId])
  @@unique([electionId, nomor_urut])
}

enum UserRole {
  SUPER_ADMIN
  PETUGAS
}

enum ElectionStatus {
  DRAFT
  UPCOMING
  ONGOING
  FINISHED
  CANCELLED
}