generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    Int        @id @default(autoincrement())
  name                  String
  email                 String     @unique
  password              String
  role                  UserRole
  tpsId                 Int?
  electionId            Int?

  activationCode        String?
  isActive              Boolean    @default(true)

  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  tps                   Tps?       @relation(fields: [tpsId], references: [id])
  election              Election?  @relation(fields: [electionId], references: [id])

  otpResetPasswords     OTPResetPassword[]

  @@index([electionId, isActive])
  @@index([electionId])
}


model Election {
  id                Int             @id @default(autoincrement())
  name              String
  desa              String
  kecamatan         String
  kabupatenKota     String
  provinsi          String
  description       String?
  logo              String?
  startAt           DateTime
  endAt             DateTime
  status            ElectionStatus  @default(DRAFT)

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  users             User[]
  tps               Tps[]
  candidates        Candidate[]
  candidateMembers  CandidateMember[]
  voters            Voter[]
  tokenVotes        TokenVote[]
  votes             Vote[]
}


model Tps {
  id          Int      @id @default(autoincrement())
  name        String
  alamat      String
  rt          Int
  rw          Int

  electionId  Int

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  election    Election @relation(fields: [electionId], references: [id], onDelete: Cascade)

  users       User[]
  voters      Voter[]
  tokenVotes  TokenVote[]
  votes       Vote[]

  @@index([electionId])
}


model Candidate {
  id                Int               @id @default(autoincrement())
  nomor             Int
  img               String
  vision            String
  mission           String
  electionId        Int
  
  election          Election          @relation(fields: [electionId], references: [id], onDelete: Cascade)

  members           CandidateMember[]
  
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  votes             Vote[]

  @@index([electionId])
  @@unique([electionId, nomor])
}


model CandidateMember {
  id                Int               @id @default(autoincrement())
  name              String
  img               String?
  position          String
  order             Int
  electionId        Int
  candidateId       Int
  
  election          Election          @relation(fields: [electionId], references: [id], onDelete: Cascade)
  candidate         Candidate         @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([electionId])
  @@index([candidateId])
  @@unique([position, candidateId])
}


model Voter {
  id              Int           @id @default(autoincrement())
  name            String
  nik             String?
  info            String?
  isPresent       Boolean       @default(false)
  isVoted         Boolean       @default(false)
  electionId      Int
  tpsId           Int

  election        Election      @relation(fields:[electionId], references:[id], onDelete: Cascade)
  tps             Tps           @relation(fields:[tpsId], references:[id], onDelete: Cascade)

  tokenVotes      TokenVote[]
  votes           Vote[]          

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([electionId])
  @@index([electionId, tpsId])
  @@index([electionId, tpsId, isPresent])
  @@index([electionId, tpsId, isVoted])
  @@unique([electionId, nik])
}



model TokenVote {
  id            Int         @id @default(autoincrement())
  token         String
  isUsed        Boolean     @default(false)
  expiredAt     DateTime
  usedAt        DateTime?

  electionId    Int
  tpsId         Int
  voterId       Int

  election      Election    @relation(fields:[electionId], references:[id], onDelete: Cascade)
  tps           Tps         @relation(fields:[tpsId], references:[id], onDelete: Cascade)
  voter         Voter       @relation(fields:[voterId], references:[id], onDelete: Cascade)

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([token])
  @@index([voterId])
  @@index([electionId, tpsId])
  @@unique([electionId, token])
}



model Vote {
  id            Int         @id @default(autoincrement())
  
  electionId    Int
  voterId       Int
  candidateId   Int
  tpsId         Int

  election      Election    @relation(fields:[electionId], references:[id])
  voter         Voter       @relation(fields:[voterId], references:[id])
  candidate     Candidate   @relation(fields:[candidateId], references:[id])
  tps           Tps         @relation(fields:[tpsId], references:[id])

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt


  @@index([electionId])
  @@index([candidateId])
  @@index([tpsId])
  @@unique([electionId, voterId])
}




model OTPResetPassword {
  id              Int         @id @default(autoincrement())
  otp             String      @unique
  isUsed          Boolean     @default(false)
  expiredAt       DateTime

  userId          Int

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  user            User        @relation(fields:[userId], references:[id], onDelete: Cascade)

  @@index([userId])
}



enum UserRole {
  SUPER_ADMIN
  PETUGAS
}

enum ElectionStatus {
  DRAFT
  UPCOMING
  ONGOING
  FINISHED
  CANCELLED
}